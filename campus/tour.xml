<krpano version="1.23" title="Virtual Tour" bgcolor="0xD8DDE3">

	<include url="skin/vtourskin.xml?v=6" />
	<!-- CIE: scene XML tap trung tai campus; tai nguyen van nam trong labs/cie. -->
	<include url="scenes/cie.xml?v=1" />
	<!-- GAME LAB: scene XML tap trung tai campus; bang Falcon va tai nguyen van nam trong labs/game. -->
	<include url="scenes/game.xml?v=1" />
	<!-- CTS LAB: scene XML tap trung tai campus; anh panorama van nam trong labs/cts/panos. -->
	<include url="scenes/cts.xml?v=1" />
	<!-- FPT LAB: scene XML tap trung tai campus; tai nguyen van nam trong labs/fpt. -->
	<include url="scenes/fpt.xml?v=1" />
	<!-- THU VIEN: scene XML tap trung tai campus; tai nguyen van nam trong labs/Library. -->
	<include url="scenes/library.xml?v=1" />
	<!-- SAMSUNG LAB: scene XML tap trung tai campus; tai nguyen van nam trong labs/samsung. -->
	<include url="scenes/samsung.xml?v=1" />
	<!-- VIETTEL LAB: scene XML tap trung tai campus; tai nguyen van nam trong labs/Viettel. -->
	<include url="scenes/viettel.xml?v=1" />
	<style name="skin_infopoststyle"
	       visible="false" enabled="false"
	       url="/assets/icons/infopost.svg"
	       edge="center" distorted="false"
	       width="96" height="96" scale="0.42" alpha="0.94"
	       depth="1000" zorder="20"
	       onloaded="infoport_pulse(get(name),0.42,0.49);"
	       onover="tween(alpha,1.0,0.18);"
	       onout="tween(alpha,0.94,0.22);" />

	<!-- Chỉnh pulse infoport ở thông số trước easeInOutSine. -->
	<action name="infoport_pulse">
		if(hotspot[%1],
			tween(hotspot[%1].scale, %3, 0.4, easeInOutSine,
				tween(hotspot[%1].scale, %2, 0.4, easeInOutSine,
					infoport_pulse(%1,%2,%3);
				);
			);
		);
	</action>

	<events onnewscene="js(handleSceneChange(get(xml.scene)))" onloadcomplete="skin_hideskin(instant); js(handleSceneLoadComplete(get(xml.scene)));" keep="true" />

	<action name="open_web_info">
		js(openInfo());
	</action>
	<action name="info_show_from_hotspot">
		set(info_hs_name, %1);
		set(info_title_val, get(hotspot[get(info_hs_name)].infotitle));
		set(info_text_val, get(hotspot[get(info_hs_name)].infotext));
		if(info_title_val == null OR info_title_val == '', set(info_title_val, 'Thông tin'); );
		if(info_text_val == null OR info_text_val == '', set(info_text_val, 'Đang cập nhật...'); );
		set(layer[xml_info_title].html, get(info_title_val));
		set(layer[xml_info_text].html, get(info_text_val));
		set(layer[xml_info_box].visible, true);
	</action>

	<action name="info_hide">
		set(layer[xml_info_box].visible, false);
	</action>

	<layer name="xml_info_box"
		type="container"
		align="lefttop"
		x="20"
		y="80"
		width="320"
		autoheight="true"
		bgalpha="0.82"
		bgcolor="0x111111"
		roundedge="10"
		visible="false"
		zorder="300">

		<layer name="xml_info_title"
			type="text"
			x="12"
			y="10"
			width="296"
			css="color:#ffffff;font-size:16px;font-weight:bold;" />

		<layer name="xml_info_text"
			type="text"
			x="12"
			y="40"
			width="296"
			autoheight="true"
			css="color:#f1f1f1;font-size:13px;line-height:1.4;" />

		<layer name="xml_info_close"
			type="text"
			align="righttop"
			x="-8"
			y="8"
			html="✕"
			css="color:#ffffff;font-size:16px;"
			handcursor="true"
			onclick="info_hide();" />
	</layer>
    <!-- Info Hotspot Style -->
    <style name="skin_info_hotspot" 
           visible="false" enabled="false"
           url="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='30' fill='%23ffffff' opacity='0.2'/%3E%3Ccircle cx='50' cy='50' r='18' fill='%23ffffff' opacity='0.8'/%3E%3Ccircle cx='50' cy='50' r='12' fill='%23e31b23'/%3E%3C/svg%3E"
           width="96" height="96" scale="0.42"
           edge="center" 
           distorted="false" 
           tooltip="Xem thông tin chi tiết"
           onclick="js(window.openHotspotInfo(get(xml.scene), get(name)));" 
           onloaded="infoport_pulse(get(name),0.42,0.49);"
           onover="tween(alpha,1.0,0.18);"
           onout="tween(alpha,0.94,0.22);"
           />

	<!-- customize skin settings -->
	<skin_settings maps="false"
	               maps_type="openstreetmaps"
	               maps_bing_api_key=""
	               maps_google_api_key=""
	               maps_zoombuttons="false"
	               maps_loadonfirstuse="true"
	               gyro="true"
	               gyro_keeplookingdirection="false"
	               webvr="true"
	               webvr_keeplookingdirection="true"
	               webvr_prev_next_hotspots="true"
	               autotour="false"
	               littleplanetintro="false"
	               followmousecontrol="false"
	               title="true"
	               thumbs="true"
	               thumbs_width="120" thumbs_height="80" thumbs_padding="10" thumbs_crop="0|40|240|160"
	               thumbs_opened="false"
	               thumbs_text="false"
	               thumbs_dragging="true"
	               thumbs_onhoverscrolling="false"
	               thumbs_scrollbuttons="false"
	               thumbs_scrollindicator="false"
	               thumbs_loop="false"
	               tooltips_buttons="false"
	               tooltips_thumbs="false"
	               tooltips_hotspots="false"
	               tooltips_mapspots="false"
	               deeplinking="false"
	               loadscene_flags="MERGE|PRELOAD"
	               loadscene_blend="BLEND(0.55, easeInOutSine)"
	               loadscene_blend_prev="BLEND(0.55, easeInOutSine)"
	               loadscene_blend_next="BLEND(0.55, easeInOutSine)"
	               loadingtext=""
	               layout_width="100%"
	               layout_maxwidth="814"
	               controlbar_width="-24"
	               controlbar_height="40"
	               controlbar_offset="20"
	               controlbar_offset_closed="-40"
	               controlbar_overlap.no-fractionalscaling="10"
	               controlbar_overlap.fractionalscaling="0"
	               design_skin_images="vtourskin.png"
	               design_bgcolor="0x2D3E50"
	               design_bgalpha="0.8"
	               design_bgborder="0"
	               design_bgroundedge="1"
	               design_bgshadow="0 4 10 0x000000 0.3"
	               design_thumbborder_bgborder="3 0xFFFFFF 1.0"
	               design_thumbborder_padding="2"
	               design_thumbborder_bgroundedge="0"
	               design_text_css="color:#FFFFFF; font-family:Arial;"
	               design_text_shadow="1"
	               />

	<!-- SOUND PLUGIN -->
	<plugin name="soundinterface"
			url="%SWFPATH%/plugins/soundinterface.js"
			preload="true" />

	<!-- KHUON VIEN: scene campus duoc tach rieng de de bao tri. -->
	<include url="scenes/campus.xml?v=1" />

</krpano>
